{% extends 'base.html.twig' %}

{% block title %}Gérer les utilisateurs{% endblock %}

{% block body %}
    <div class="admin-page">
        <div class="admin-container">

            <a href="{{ path('app_admin_home') }}" class="admin-back">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"/>
                    <polyline points="12 19 5 12 12 5"/>
                </svg>
                Retour à l'administration
            </a>

            <div class="users-head">
                <div class="admin-header">
                    <p class="admin-label">Administration</p>
                    <h1>Gérer les utilisateurs</h1>
                    <p class="admin-subtitle">{{ total|default(participants|length) }} compte(s) enregistré(s) sur la
                        plateforme.</p>
                </div>

                <div class="users-head-actions">
                    <button type="button" class="btn-outline"
                            onclick="document.getElementById('modal-import').showModal()">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                            <polyline points="17 8 12 3 7 8"/>
                            <line x1="12" y1="3" x2="12" y2="15"/>
                        </svg>
                        Importer un fichier CSV
                    </button>
                    <a href="{{ path('app_admin_add_user') }}" class="btn-corail">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            <line x1="19" y1="8" x2="19" y2="14"/>
                            <line x1="22" y1="11" x2="16" y2="11"/>
                        </svg>
                        Inscrire un utilisateur
                    </a>
                </div>
            </div>

            {% set rejets = app.session.get('import_rejects') %}
            {% if rejets %}
                <div class="import-report">
                    <div class="import-report-head">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path
                                d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                            <line x1="12" y1="9" x2="12" y2="13"/>
                            <line x1="12" y1="17" x2="12.01" y2="17"/>
                        </svg>
                        {{ rejets|length }} ligne(s) ignorée(s) lors du dernier import
                    </div>
                    <table class="import-report-table">
                        <thead>
                        <tr>
                            <th>Ligne</th>
                            <th>Email</th>
                            <th>Raison</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for r in rejets %}
                            <tr>
                                <td>{{ r.line }}</td>
                                <td>{{ r.email ?: '—' }}</td>
                                <td>{{ r.reason }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% do app.session.remove('import_rejects') %}
            {% endif %}

            <form method="get" action="{{ path('app_admin_users') }}" class="users-filters" role="search">
                <div class="search-box">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"/>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                    <label>
                        <input type="text" name="recherche"
                               value="{{ app.request.query.get('recherche') }}"
                               placeholder="Rechercher un utilisateur…">
                    </label>
                </div>

                {% if campusList is defined %}
                    <label>
                        <select name="campus" onchange="this.form.submit()">
                            <option value="">Tous les campus</option>
                            {% for c in campusList %}
                                <option value="{{ c.id }}" {{ app.request.query.get('campus') == c.id ? 'selected' }}>
                                    {{ c.nom }}
                                </option>
                            {% endfor %}
                        </select>
                    </label>
                {% endif %}
            </form>

            <div class="users-table-card">
                <table class="users-table">
                    <thead>
                    <tr>
                        <th>Utilisateur</th>
                        <th>Email</th>
                        <th>Pseudo</th>
                        <th>Campus</th>
                        <th>Statut</th>
                        <th class="col-actions">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for participant in participants %}
                        {% set fullname = (participant.nom ~ ' ' ~ participant.prenom)|trim %}
                        {% set initiales = ((participant.prenom|default('')|first) ~ (participant.nom|default('')|first))|upper %}
                        {% if initiales is empty %}
                            {% set initiales = participant.email|first|upper %}
                        {% endif %}

                        <tr>
                            <td>
                                <div class="user-block">
                                    <span class="user-avatar">
                                        {% if participant.photo %}
                                            <img src="{{ asset('images/photos/' ~ participant.photo) }}" alt="">
                                        {% else %}
                                            {{ initiales }}
                                        {% endif %}
                                    </span>
                                    <span class="user-name">
                                        {{ fullname ? (participant.nom|upper ~ ' ' ~ participant.prenom)|trim : '—' }}
                                    </span>
                                    {% if participant.administrateur %}
                                        <span class="badge-admin">Admin</span>
                                    {% endif %}
                                </div>
                            </td>
                            <td class="cell-email">{{ participant.email }}</td>
                            <td>{{ participant.pseudo ?: '—' }}</td>
                            <td class="cell-campus">{{ participant.campus ? participant.campus.nom : '—' }}</td>
                            <td>
                                {% if participant.actif %}
                                    <span class="status status--actif">Actif</span>
                                {% else %}
                                    <span class="status status--inactif">Inactif</span>
                                {% endif %}
                            </td>
                            <td class="col-actions">
                                <div class="row-actions">
                                    <a href="{{ path('app_admin_user_edit', {id: participant.id}) }}"
                                       class="btn-action btn-action--edit">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                            <path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                        </svg>
                                        Modifier
                                    </a>

                                    <form method="post" class="inline-form"
                                          action="{{ path('app_admin_user_toggle', {id: participant.id}) }}">
                                        <input type="hidden" name="_token"
                                               value="{{ csrf_token('toggle' ~ participant.id) }}">
                                        {% if participant.actif %}
                                            <button type="submit" class="btn-action btn-action--off">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                     stroke-width="2"
                                                     stroke-linecap="round" stroke-linejoin="round">
                                                    <circle cx="12" cy="12" r="10"/>
                                                    <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
                                                </svg>
                                                Désactiver
                                            </button>
                                        {% else %}
                                            <button type="submit" class="btn-action btn-action--on">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                     stroke-width="2"
                                                     stroke-linecap="round" stroke-linejoin="round">
                                                    <polyline points="20 6 9 17 4 12"/>
                                                </svg>
                                                Réactiver
                                            </button>
                                        {% endif %}
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="users-empty">Aucun utilisateur trouvé.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>

        </div>
    </div>

    <dialog id="modal-import" class="modal">
        <div class="modal-head">
            <h2>Importer des utilisateurs</h2>
            <button type="button" class="modal-close" aria-label="Fermer"
                    onclick="document.getElementById('modal-import').close()">✕
            </button>
        </div>

        <form method="post" action="{{ path('app_admin_import_users') }}" enctype="multipart/form-data">
            <input type="hidden" name="_token" value="{{ csrf_token('import_users') }}">

            <p class="import-help">
                Fichier <strong>.csv</strong> (séparateur <code>;</code>) avec une ligne d'en-tête :
                <code>email;password;campus;admin</code><br>
                Le campus est indiqué par son <strong>nom</strong>. La colonne <code>admin</code> accepte
                <code>1</code>/<code>0</code>, <code>oui</code>/<code>non</code>, <code>true</code>/<code>false</code>.
            </p>

            <label class="field-label" for="csv-file">Fichier CSV</label>
            <input type="file" id="csv-file" name="csv" accept=".csv,text/csv" required>

            <div class="modal-actions">
                <button type="button" class="btn-ghost"
                        onclick="document.getElementById('modal-import').close()">Annuler
                </button>
                <button type="submit" class="btn-corail">Importer</button>
            </div>
        </form>
    </dialog>
{% endblock %}
