{% extends 'base.html.twig' %}

{% block title %}Liste des utilisateurs{% endblock %}

{% block body %}

    <h1>Liste des utilisateurs</h1>

    <a href="{{ path ('app_admin_add_user') }}">Ajouter un utilisateur</a>

    <form method="get" action="{{ path('app_admin_users') }}">
        <label for="recherche">
            Cherchez un participant:
            <input type="text" name="recherche" placeholder="Search">
        </label>
        <button type="submit">Rechercher</button>
    </form>

    {% for participant in participants %}

        {% if not participant.nom and not participant.prenom %}
            <p>{{ participant.email }}</p>
        {% else %}
            <p> {{ participant.nom }} {{ participant.prenom }}</p>
        {% endif %}
        <a href="{{ path ('app_admin_user_edit', {id: participant.id}) }}">Modifier</a>

        <form method="post" action="{{ path('app_admin_user_delete', {id: participant.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ participant.id) }}">
            <button type="submit">Supprimer</button>
        </form>

    {% endfor %}

    <a href="{{ path('app_admin_home') }}">Retour</a>

{% endblock %}
