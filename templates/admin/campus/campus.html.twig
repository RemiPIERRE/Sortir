{% extends 'base.html.twig' %}

{% block title %}Gérer les campus{% endblock %}

{% block body %}
    <div class="admin-page">
        <div class="admin-container">

            <a href="{{ path('app_admin_home') }}" class="admin-back">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"/>
                    <polyline points="12 19 5 12 12 5"/>
                </svg>
                Retour à l'administration
            </a>

            <div class="users-head">
                <div class="admin-header">
                    <p class="admin-label">Administration</p>
                    <h1>Gérer les campus</h1>
                    <p class="admin-subtitle">{{ total|default(campusList|length) }} campus enregistré(s) sur la
                        plateforme.</p>
                </div>

                <div class="users-head-actions">
                    <button type="button" class="btn-corail"
                            onclick="document.getElementById('modal-campus').showModal()">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="5" x2="12" y2="19"/>
                            <line x1="5" y1="12" x2="19" y2="12"/>
                        </svg>
                        Ajouter un campus
                    </button>
                </div>
            </div>

            <form method="get" action="{{ path('app_admin_campus') }}" class="users-filters" role="search">
                <div class="search-box">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"/>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                    <input type="text" name="nom"
                           value="{{ app.request.query.get('nom') }}"
                           placeholder="Rechercher un campus…">
                </div>
            </form>

            <div class="users-table-card">
                <table class="users-table">
                    <thead>
                    <tr>
                        <th>Campus</th>
                        <th>Participants rattachés</th>
                        <th>Sorties rattachées</th>
                        <th class="col-actions">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for campus in campusList %}
                        <tr>
                            <td>
                                <div class="campus-name">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                         stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M3 21h18"/>
                                        <path d="M6 21V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v17"/>
                                        <line x1="9" y1="7" x2="10" y2="7"/>
                                        <line x1="14" y1="7" x2="15" y2="7"/>
                                        <line x1="9" y1="11" x2="10" y2="11"/>
                                        <line x1="14" y1="11" x2="15" y2="11"/>
                                        <line x1="9" y1="15" x2="10" y2="15"/>
                                        <line x1="14" y1="15" x2="15" y2="15"/>
                                    </svg>
                                    {{ campus.nom }}
                                </div>
                            </td>
                            <td class="cell-count">{{ campus.participants|length }} participant(s)</td>
                            <td class="cell-count">{{ campus.sorties|length }} sortie(s)</td>
                            <td class="col-actions">
                                <div class="row-actions">
                                    <a href="{{ path('app_admin_campus_edit', {id: campus.id}) }}"
                                       class="btn-action btn-action--edit">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                            <path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                        </svg>
                                        Modifier
                                    </a>

                                    <form method="post" class="inline-form"
                                          action="{{ path('app_admin_campus_delete', {id: campus.id}) }}"
                                          onsubmit="return confirm('Supprimer le campus « {{ campus.nom|e('js') }} » ?');">
                                        <input type="hidden" name="_token"
                                               value="{{ csrf_token('delete' ~ campus.id) }}">
                                        <button type="submit" class="btn-action btn-action--off">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="3 6 5 6 21 6"/>
                                                <path
                                                    d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                                <line x1="10" y1="11" x2="10" y2="17"/>
                                                <line x1="14" y1="11" x2="14" y2="17"/>
                                            </svg>
                                            Supprimer
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="users-empty">Aucun campus trouvé.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>

        </div>
    </div>

    <dialog id="modal-campus" class="modal">
        <div class="modal-head">
            <h2>Ajouter un campus</h2>
            <button type="button" class="modal-close" aria-label="Fermer"
                    onclick="document.getElementById('modal-campus').close()">✕
            </button>
        </div>

        {{ form(form) }}
    </dialog>

    {% if form.vars.submitted and not form.vars.valid %}
        <script>
            (function () {
                var d = document.getElementById('modal-campus');
                if (d && !d.open) {
                    d.showModal();
                }
            })();
        </script>
    {% endif %}
{% endblock %}
