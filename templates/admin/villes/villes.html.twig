{% extends 'base.html.twig' %}

{% block title %}Gérer les villes et les lieux{% endblock %}

{% block body %}
    <div class="admin-page">
        <div class="admin-container">

            <a href="{{ path('app_admin_home') }}" class="admin-back">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"/>
                    <polyline points="12 19 5 12 12 5"/>
                </svg>
                Retour à l'administration
            </a>

            <header class="admin-header">
                <p class="admin-label">Administration</p>
                <h1>Gérer les villes et les lieux</h1>
                <p class="admin-subtitle">Ajoutez, modifiez ou supprimez les villes et leurs lieux de sortie.</p>
            </header>

            <section class="admin-section">
                <div class="section-head">
                    <h2 class="section-title">
                        Villes <span class="count">({{ villes|length }})</span>
                    </h2>
                    <button type="button" class="btn-corail"
                            onclick="document.getElementById('modal-ville').showModal()">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="5" x2="12" y2="19"/>
                            <line x1="5" y1="12" x2="19" y2="12"/>
                        </svg>
                        Ajouter une ville
                    </button>
                </div>

                <form method="get" action="{{ path('app_admin_villes') }}" class="users-filters" role="search">
                    <div class="search-box">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"/>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                        </svg>
                        <input type="text" name="qville" value="{{ app.request.query.get('qville') }}"
                               placeholder="Rechercher une ville…">
                    </div>
                </form>

                <div class="users-table-card">
                    <table class="users-table">
                        <thead>
                        <tr>
                            <th>Ville</th>
                            <th>Code postal</th>
                            <th>Lieux rattachés</th>
                            <th class="col-actions">Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for ville in villes %}
                            <tr>
                                <td>
                                    <div class="campus-name">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                                            <circle cx="12" cy="10" r="3"/>
                                        </svg>
                                        {{ ville.nom }}
                                    </div>
                                </td>
                                <td class="cell-count">{{ ville.codePostal }}</td>
                                <td class="cell-count">{{ ville.lieux|length }} lieu(x)</td>
                                <td class="col-actions">
                                    <div class="row-actions">
                                        <a href="{{ path('app_admin_edit_ville', {id: ville.id}) }}"
                                           class="btn-action btn-action--edit">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                                <path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                            </svg>
                                            Modifier
                                        </a>

                                        {% if ville.lieux is empty %}
                                            <form method="post" class="inline-form"
                                                  action="{{ path('app_admin_delete_ville', {id: ville.id}) }}"
                                                  onsubmit="return confirm('Supprimer la ville « {{ ville.nom|e('js') }} » ?');">
                                                <input type="hidden" name="_token"
                                                       value="{{ csrf_token('delete_ville' ~ ville.id) }}">
                                                <button type="submit" class="btn-action btn-action--off">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                         stroke-width="2"
                                                         stroke-linecap="round" stroke-linejoin="round">
                                                        <polyline points="3 6 5 6 21 6"/>
                                                        <path
                                                            d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                                    </svg>
                                                    Supprimer
                                                </button>
                                            </form>
                                        {% else %}
                                            <span class="btn-action btn-action--off is-disabled"
                                                  title="{{ ville.lieux|length }} lieu(x) rattaché(s) : suppression impossible">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                         stroke-width="2"
                                                         stroke-linecap="round" stroke-linejoin="round">
                                                        <polyline points="3 6 5 6 21 6"/>
                                                        <path
                                                            d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                                    </svg>
                                                    Supprimer
                                                </span>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4" class="users-empty">Aucune ville trouvée.</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="admin-section">
                <div class="section-head">
                    <h2 class="section-title">
                        Lieux <span class="count">({{ lieux|length }})</span>
                    </h2>
                    <button type="button" class="btn-corail"
                            onclick="document.getElementById('modal-lieu').showModal()">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="5" x2="12" y2="19"/>
                            <line x1="5" y1="12" x2="19" y2="12"/>
                        </svg>
                        Ajouter un lieu
                    </button>
                </div>

                <form method="get" action="{{ path('app_admin_villes') }}" class="users-filters" role="search">
                    <div class="search-box">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"/>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                        </svg>
                        <input type="text" name="qlieu" value="{{ app.request.query.get('qlieu') }}"
                               placeholder="Rechercher un lieu…">
                    </div>
                </form>

                <div class="users-table-card">
                    <table class="users-table">
                        <thead>
                        <tr>
                            <th>Lieu</th>
                            <th>Ville</th>
                            <th>Rue</th>
                            <th>Coordonnées</th>
                            <th>Sorties</th>
                            <th class="col-actions">Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for lieu in lieux %}
                            <tr>
                                <td>
                                    <div class="campus-name">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                                            <circle cx="12" cy="10" r="3"/>
                                        </svg>
                                        {{ lieu.nom }}
                                    </div>
                                </td>
                                <td class="cell-campus">{{ lieu.ville ? lieu.ville.nom : '—' }}</td>
                                <td class="cell-count">{{ lieu.rue ?: '—' }}</td>
                                <td class="cell-count">
                                    {% if lieu.latitude is not null and lieu.longitude is not null %}
                                        <span class="map-coords">{{ lieu.latitude }}, {{ lieu.longitude }}</span>
                                    {% else %}—{% endif %}
                                </td>
                                <td class="cell-count">{{ lieu.sorties|length }}</td>
                                <td class="col-actions">
                                    <div class="row-actions">
                                        <a href="{{ path('app_admin_edit_lieu', {id: lieu.id}) }}"
                                           class="btn-action btn-action--edit">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                                <path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                            </svg>
                                            Modifier
                                        </a>

                                        {% if lieu.sorties is empty %}
                                            <form method="post" class="inline-form"
                                                  action="{{ path('app_admin_delete_lieu', {id: lieu.id}) }}"
                                                  onsubmit="return confirm('Supprimer le lieu « {{ lieu.nom|e('js') }} » ?');">
                                                <input type="hidden" name="_token"
                                                       value="{{ csrf_token('delete_lieu' ~ lieu.id) }}">
                                                <button type="submit" class="btn-action btn-action--off">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                         stroke-width="2"
                                                         stroke-linecap="round" stroke-linejoin="round">
                                                        <polyline points="3 6 5 6 21 6"/>
                                                        <path
                                                            d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                                    </svg>
                                                    Supprimer
                                                </button>
                                            </form>
                                        {% else %}
                                            <span class="btn-action btn-action--off is-disabled"
                                                  title="{{ lieu.sorties|length }} sortie(s) rattachée(s) : suppression impossible">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                         stroke-width="2"
                                                         stroke-linecap="round" stroke-linejoin="round">
                                                        <polyline points="3 6 5 6 21 6"/>
                                                        <path
                                                            d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                                    </svg>
                                                    Supprimer
                                                </span>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="users-empty">Aucun lieu trouvé.</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>

        </div>
    </div>

    <dialog id="modal-ville" class="modal">
        <div class="modal-head">
            <h2>Ajouter une ville</h2>
            <button type="button" class="modal-close" aria-label="Fermer"
                    onclick="document.getElementById('modal-ville').close()">✕
            </button>
        </div>
        {{ form(villeForm) }}
    </dialog>

    <dialog id="modal-lieu" class="modal">
        <div class="modal-head">
            <h2>Ajouter un lieu</h2>
            <button type="button" class="modal-close" aria-label="Fermer"
                    onclick="document.getElementById('modal-lieu').close()">✕
            </button>
        </div>
        {{ form(lieuForm) }}
    </dialog>

    {% if villeForm.vars.submitted and not villeForm.vars.valid %}
        <script>document.getElementById('modal-ville')?.showModal();</script>
    {% endif %}
    {% if lieuForm.vars.submitted and not lieuForm.vars.valid %}
        <script>document.getElementById('modal-lieu')?.showModal();</script>
    {% endif %}
{% endblock %}
