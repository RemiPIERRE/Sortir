{% extends 'base.html.twig' %}

{% block title %}Modifier un lieu{% endblock %}

{% block body %}
    <div class="admin-page">
        <div class="admin-container form-page">

            <a href="{{ path('app_admin_villes') }}" class="admin-back">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"/>
                    <polyline points="12 19 5 12 12 5"/>
                </svg>
                Retour à la gestion
            </a>

            <header class="admin-header">
                <p class="admin-label">Administration</p>
                <h1>Modifier « {{ lieu.nom }} »</h1>
                <p class="admin-subtitle">Mettez à jour les informations du lieu et sa ville de rattachement.</p>
            </header>

            <div class="form-card">
                {{ form(form) }}
            </div>

        </div>
    </div>
{% endblock %}
