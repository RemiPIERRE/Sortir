{% extends 'base.html.twig' %}

{% block title %}Détail de la sortie{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <link
        rel="stylesheet"
        href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    >
{% endblock %}

{% block body %}

    <h1>{{ sortie.nom }}</h1>

    <section>
        <p>État : {{ sortie.etat ? sortie.etat.libelle : '' }}</p>
        <p>Organisateur : {{ sortie.organisateur ? sortie.organisateur.pseudo : '' }}</p>
        <p>Date et heure de début : {{ sortie.dateHeureDebut ? sortie.dateHeureDebut|date('d/m/Y à H:i') : '' }}</p>
        <p>Durée : {{ sortie.duree }} minutes</p>
        <p>Date limite d'inscription
            : {{ sortie.dateLimiteInscription ? sortie.dateLimiteInscription|date('d/m/Y') : '' }}</p>
        <p>Nombre de places : {{ sortie.inscrits|length }} / {{ sortie.nbInscriptionMax }}</p>
        <p>Campus : {{ sortie.campus ? sortie.campus.nom : '' }}</p>
        <p>Lieu : {{ sortie.lieu ? sortie.lieu.nom : '' }}</p>

        {% if sortie.lieu
            and sortie.lieu.latitude is not null
            and sortie.lieu.longitude is not null
        %}
            <div
                id="map"
                data-latitude="{{ sortie.lieu.latitude }}"
                data-longitude="{{ sortie.lieu.longitude }}"
                data-lieu="{{ sortie.lieu.nom }}"
            ></div>
        {% endif %}

        <p>Description : {{ sortie.infoSortie }}</p>

        {% if sortie.etat and sortie.etat.libelle == 'Annulée' and sortie.motifAnnulation %}
            <p><strong>Motif d'annulation :</strong> {{ sortie.motifAnnulation }}</p>
        {% endif %}

        <form method="post" action="{{ path ('app_sortie_register', {id: sortie.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('inscription' ~ sortie.id) }}">
            <button type="submit" {% if not peut_inscrire or deja_inscrit %} disabled {% endif %} >S'inscrire</button>
        </form>

        <form method="post" action="{{ path ('app_sortie_withdraw', {id: sortie.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('desister' ~ sortie.id) }}">
            <button type="submit" {% if not peut_desister %} disabled {% endif %}> Se désister </button>
        </form>

    </section>


    <section>
        <h2>Participants inscrits</h2>
        {% if sortie.inscrits is empty %}
            <p>Aucun participant inscrit pour le moment.</p>
        {% else %}
            <ul>
                {% for inscrit in sortie.inscrits %}
                    <li>{{ inscrit.prenom }} {{ inscrit.nom }} ({{ inscrit.pseudo }})</li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>

    <p>
        <a href="{{ path('app_home') }}">Retour à la liste</a>
    </p>

{% endblock %}

{% block javascripts %}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    {{ parent() }}
{% endblock %}

