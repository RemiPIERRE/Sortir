{% extends 'base.html.twig' %}

{% block title %}Annuler une sortie{% endblock %}

{% block body %}
    <div class="admin-page">
        <div class="admin-container form-page">

            <a href="{{ path('app_sortie_show', {id: sortie.id}) }}" class="admin-back">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"/>
                    <polyline points="12 19 5 12 12 5"/>
                </svg>
                Retour à la sortie
            </a>

            <header class="admin-header">
                <p class="admin-label">Annulation</p>
                <h1>Annuler une sortie</h1>
                <p class="admin-subtitle">Cette action notifiera tous les participants inscrits. Merci de préciser un
                    motif.</p>
            </header>

            <div class="form-card">
                <div class="cancel-summary">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path
                            d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2z"/>
                    </svg>
                    <div>
                        <div class="cancel-summary-title">{{ sortie.nom }}</div>
                        <div class="cancel-summary-meta">
                            {{ sortie.dateHeureDebut ? sortie.dateHeureDebut|date('d/m/Y à H:i') : '' }}
                            {%- if sortie.lieu %} · {{ sortie.lieu.nom }}
                                {%- if sortie.lieu.ville %}, {{ sortie.lieu.ville.nom }}{% endif -%}
                            {% endif %}
                        </div>
                    </div>
                </div>

                <form method="post" action="{{ path('app_sortie_cancel', {id: sortie.id}) }}" class="cancel-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('annuler' ~ sortie.id) }}">

                    <label for="motif" class="field-label">Motif d'annulation</label>
                    <textarea id="motif" name="motif" required
                              placeholder="Ex : Salle indisponible suite à un imprévu…"></textarea>
                    <p class="field-help">Ce motif sera visible par tous les participants inscrits.</p>

                    <div class="form-actions">
                        <a href="{{ path('app_sortie_show', {id: sortie.id}) }}" class="btn-ghost">Annuler l'action</a>
                        <button type="submit" class="btn-danger">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
                            </svg>
                            Confirmer l'annulation de la sortie
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </div>
{% endblock %}
