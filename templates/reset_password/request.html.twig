{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}
    <div class="admin-page">
        <div class="admin-container form-page">

            <header class="admin-header">
                <p class="admin-label">Mot de passe</p>
                <h1>Mot de passe oublié</h1>
                <p class="admin-subtitle">Saisissez votre adresse email : nous vous enverrons un lien pour réinitialiser
                    votre mot de passe.</p>
            </header>

            <div class="form-card">
                {{ form_start(requestForm) }}
                {{ form_row(requestForm.email, { label: 'Adresse email' }) }}
                <p class="field-help">Si un compte existe pour cette adresse, un email vous sera envoyé.</p>
                <button class="btn-corail">Envoyer le lien de réinitialisation</button>
                {{ form_end(requestForm) }}
            </div>

            <p class="form-back">
                <a href="{{ path('app_login') }}">← Retour à la connexion</a>
            </p>

        </div>
    </div>
{% endblock %}
