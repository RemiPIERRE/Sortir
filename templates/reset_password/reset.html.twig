{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe{% endblock %}

{% block body %}
    <div class="admin-page">
        <div class="admin-container form-page">

            <header class="admin-header">
                <p class="admin-label">Mot de passe</p>
                <h1>Choisir un nouveau mot de passe</h1>
                <p class="admin-subtitle">Définissez le nouveau mot de passe de votre compte.</p>
            </header>

            <div class="form-card">
                {{ form_start(resetForm) }}
                {{ form_row(resetForm.plainPassword) }}
                <button class="btn-corail">Réinitialiser le mot de passe</button>
                {{ form_end(resetForm) }}
            </div>

        </div>
    </div>
{% endblock %}
