{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}

    <h1>Accueil</h1>

    <section class="infos-accueil">
        <p>Date du jour : {{ "now"|date("d/m/Y") }}</p>

        {% if app.user %}
            <p>Participant : {{ app.user.pseudo }}</p>
        {% endif %}
    </section>

    <form method="get">

        <label for="campus">Campus</label>
        <select id="campus" name="campus">
            <option value="">Tous les campus</option>
            {% for campus in campusList %}
                <option value="{{ campus.id }}">{{ campus.nom }}</option>
            {% endfor %}
        </select>

        <label for="nom">Le nom de la sortie contient</label>
        <input type="text" id="nom" name="nom">

        <label for="dateDebut">Entre</label>
        <input type="date" id="dateDebut" name="dateDebut">

        <label for="dateFin">et</label>
        <input type="date" id="dateFin" name="dateFin">

        <input type="checkbox" id="organisateur" name="organisateur">
        <label for="organisateur">Sorties dont je suis l'organisateur/trice</label>

        <input type="checkbox" id="inscrit" name="inscrit">
        <label for="inscrit">Sorties auxquelles je suis inscrit/e</label>

        <input type="checkbox" id="nonInscrit" name="nonInscrit">
        <label for="nonInscrit">Sorties auxquelles je ne suis pas inscrit/e</label>

        <input type="checkbox" id="passees" name="passees">
        <label for="passees">Sorties passées</label>

        <button type="submit">Rechercher</button>
    </form>

    <table>
        <thead>
        <tr>
            <th>Nom de la sortie</th>
            <th>Date de la sortie</th>
            <th>Clôture</th>
            <th>Inscrits / Places</th>
            <th>État</th>
            <th>Inscrit</th>
            <th>Organisateur</th>
            <th>Actions</th>
        </tr>
        </thead>

        <tbody>
        {% for sortie in sorties %}
            <tr>
                <td>{{ sortie.nom }}</td>
                <td>{{ sortie.dateHeureDebut|date('d/m/Y H:i') }}</td>
                <td>{{ sortie.dateLimiteInscription|date('d/m/Y') }}</td>
                <td>{{ sortie.inscrits|length }} / {{ sortie.nbInscriptionMax }}</td>
                <td>{{ sortie.etat.libelle }}</td>
                <td>
                    {% if app.user in sortie.inscrits %}Oui{% else %}Non{% endif %}
                </td>
                <td>
                    <a href="{{ path('app_profile', {id: sortie.organisateur.id}) }}">{{ sortie.organisateur.pseudo }}</a>
                </td>
                <td>
                    <a href="{{ path('app_sortie_show', {id: sortie.id}) }}">Afficher</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8">Aucune sortie disponible.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_sortie_create') }}">
        <button type="button">Créer une sortie</button>
    </a>

{% endblock %}
