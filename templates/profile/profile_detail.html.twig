{% extends 'base.html.twig' %}

{% block title %}Détail du profil{% endblock %}
{% block body %}

    <section>

        {# <img src="{{ asset('') }}" alt="Photo de profil"> #}

        <h1>Profil de {{ participant.pseudo }}</h1>

        <div>

            {% if participant.photo %}
                <img src="{{ asset('images/photos/' ~ participant.photo) }}" alt="Photo de profil de {{ participant.pseudo }}" width="150">
            {% endif %}

            <p>Prénom : {{ participant.prenom }}</p>
            <p>Nom : {{ participant.nom }} </p>
            <p>Téléphone : {{ participant.telephone }} </p>
            <p>Email : {{ participant.email }} </p>
            <p>Campus : {{ participant.campus.nom }} </p>
        </div>

        {% if est_mon_profil %}
            <a href="{{ path('app_profile_edit', {id: participant.id}) }}">Modifier</a>
        {% endif %}

    </section>

{% endblock %}
