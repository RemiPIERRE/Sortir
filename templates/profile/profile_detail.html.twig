{% extends 'base.html.twig' %}

{% block title %}Profil de {{ participant.pseudo }}{% endblock %}

{% block body %}

    <div class="profile-page">

        <a href="{{ path('app_home') }}" class="profile-back">← Retour</a>

        <section class="profile-hero">
            <div class="profile-avatar">
                {% if participant.photo %}
                    <img src="{{ asset('images/photos/' ~ participant.photo) }}" alt="">
                {% else %}
                    {{ participant.prenom|first|upper }}{{ participant.nom|first|upper }}
                {% endif %}
            </div>

            <div class="profile-hero-info">
                <h1>{{ participant.prenom }} {{ participant.nom }}</h1>
                <p class="profile-meta">@{{ participant.pseudo }} ·
                    Campus {{ participant.campus ? participant.campus.nom : '' }}</p>

                {% if est_mon_profil %}
                    <a href="{{ path('app_profile_edit', {id: participant.id}) }}" class="profile-edit-btn">Modifier mon
                        profil</a>
                {% else %}
                    <span class="profile-badge">Profil public</span>
                {% endif %}
            </div>
        </section>

        <section class="profile-card">
            <h2>Coordonnées</h2>

            <div class="profile-fields">
                <div class="profile-field">
                    <span class="profile-field-label">Téléphone</span>
                    <span class="profile-field-value">{{ participant.telephone ?: '—' }}</span>
                </div>
                <div class="profile-field">
                    <span class="profile-field-label">Email</span>
                    <span class="profile-field-value">{{ participant.email }}</span>
                </div>
            </div>
        </section>

    </div>

{% endblock %}
