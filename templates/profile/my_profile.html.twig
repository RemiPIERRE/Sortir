{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}

    <h1>Mon profil</h1>

    <form method="post" action="{{ path('nom_de_la_route') }}" enctype="multipart/form-data">

{#    <img src="{{ asset('') }}" alt="Photo de profil">#}


    <label for="campus">Campus</label>
    <select id="campus" name="campus" disabled>
        <option>Nantes</option>
        <option>Rennes</option>
        <option>Distanciel</option>
    </select>

    <label for="pseudo">Pseudo</label>
    <input type="text" id="pseudo" name="pseudo">

    <label for="firstname">Prénom</label>
    <input type="text" id="firstname" name="firstname">

    <label for="lastname">Nom</label>
    <input type="text" id="lastname" name="lastname">

    <label for="phone">Téléphone</label>
    <input type="tel" id="phone" name="phone">

    <label for="email">Email</label>
    <input type="email" id="email" name="email">

    <label for="password">Mot de passe</label>
    <input type="password" id="password" name="password">

    <label for="confirm_password">Confirmation</label>
    <input type="password" id="confirm_password" name="confirm_password">

    <label for="photo">Ma photo</label>
    <input type="file" id="photo" name="photo" hidden>
    <label for="photo">Télécharger</label>

    <button type="submit">
        Enregistrer
    </button>

    </form>


{% endblock %}
